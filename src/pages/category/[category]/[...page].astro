---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Pagination from '../../../components/Pagination.astro';
import ImportanceFilter from '../../../components/ImportanceFilter.astro';
import GenreFilter from '../../../components/GenreFilter.astro';
import SearchBox from '../../../components/SearchBox.astro';
import { CATEGORIES, PAGE_SIZE } from '../../../consts';
import { t } from '../../../i18n';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection(
    'posts',
    ({ data }) => (import.meta.env.PROD ? !data.draft : true)
  );

  return Object.keys(CATEGORIES).flatMap((category) => {
    const categoryPosts = posts
      .filter((post) => post.data.category === category)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(categoryPosts, { params: { category }, pageSize: PAGE_SIZE });
  });
}

const { category } = Astro.params;
const { page } = Astro.props;
const cat = CATEGORIES[category];
const ui = t('ja');
---

<BaseLayout title={`${cat.label}の記事一覧`}>
  <div class="section-head" style="margin-top: 8px;">
    <h2>
      <span class="badge" style={`background:${cat.color}; font-size: 14px; vertical-align: 3px; margin-right: 10px;`}>
        {cat.label}
      </span>
      の記事一覧
    </h2>
    <span class="count">{page.total} 件</span>
  </div>

  {cat.archived && <p class="archived-notice">📦 {ui.archivedNotice}</p>}

  <ImportanceFilter />
  <GenreFilter />
  <SearchBox />

  <div class="grid">
    {page.data.map((post) => <ArticleCard post={post} />)}
  </div>

  {page.data.length === 0 && <p>このカテゴリの記事はまだありません。</p>}

  <Pagination page={page} />
</BaseLayout>

<style>
  .archived-notice {
    margin: 0 0 20px;
    padding: 10px 14px;
    border-radius: 8px;
    background: rgba(91, 100, 120, 0.1);
    color: var(--muted);
    font-size: 13.5px;
  }
</style>
